{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevPanel",
  "version": "0.2.0-2",
  "identifier": "com.devpanel.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bin\\node\\node.exe bin\\node\\node_modules\\npm\\bin\\npm-cli.js run dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bin\\node\\node.exe bin\\node\\node_modules\\npm\\bin\\npm-cli.js run build",
      "cwd": ".."
    },
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DevPanel",
        "label": "main",
        "width": 1050,
        "height": 720,
        "minWidth": 880,
        "minHeight": 620,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
